{
  "name": "grapple",
  "displayName": "Grapple",
  "description": "Create instant checkpoints in your files and easily navigate back to exact lines of code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [

  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grapple.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "grapple.createCheckpoint",
        "title": "Grapple: Create Checkpoint"
      },
      {
        "command": "grapple.gotoCheckpoint",
        "title": "Grapple: Go to Checkpoint"
      }
    ],
    "keybindings": [
      {
        "command": "grapple.createCheckpoint",
        "key": "shift+alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "grapple.gotoCheckpoint",
        "key": "shift+alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "grapple.deleteCheckpoint",
        "key": "shift+alt+z",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
